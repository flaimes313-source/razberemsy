TELEGRAM_BOT_TOKEN=

# ===== YandexGPT =====
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
YANDEX_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YANDEX_TIMEOUT=60

# ===== База данных =====
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE

# ===== Администраторы =====
ADMIN_IDS=

# ===== Лимиты FREE =====
FREE_DAILY_LIMIT=5
FREE_PHOTO_LIMIT=2
FREE_DOCUMENT_LIMIT=1

# ===== Лимиты PRO =====
PRO_MONTHLY_LIMIT=150
PRO_PHOTO_LIMIT=30
PRO_DOCUMENT_LIMIT=10

# ===== Лимиты PRO+ =====
PRO_PLUS_MONTHLY_LIMIT=400
PRO_PLUS_PHOTO_LIMIT=100
PRO_PLUS_DOCUMENT_LIMIT=30

# ===== Приложение =====
LOG_LEVEL=INFO
ENVIRONMENT=development